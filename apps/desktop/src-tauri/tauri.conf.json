{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crafter Code",
  "version": "0.1.0",
  "identifier": "run.crafter.code",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3002",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Crafter Code",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Agent-first IDE for the AI era",
    "longDescription": "Crafter Code is a multi-agent IDE that orchestrates AI workers to help you build software faster. Features swarm coordination, provider-specific skills, and deep integration with your development workflow.",
    "copyright": "Copyright 2025 Crafter Station",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 130, "y": 190 },
        "applicationFolderPosition": { "x": 410, "y": 190 },
        "windowSize": { "width": 540, "height": 380 },
        "background": "dmg-background.png"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["crafter-code"]
      }
    }
  }
}
